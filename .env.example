# Contact form e-mail delivery (https://resend.com)
# Without these, the form shows an error with the phone number / e-mail as a fallback.
RESEND_API_KEY=
# Where form submissions are sent (comma-separated for multiple recipients)
CONTACT_TO_EMAIL=info@denemeusu.com
# Sender address – must be on a domain verified in Resend
CONTACT_FROM_EMAIL="Deneme Üssü Web <form@denemeusu.com>"
